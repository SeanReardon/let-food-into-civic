# Telnyx API Key (from https://portal.telnyx.com → API Keys)
TELNYX_LET_FOOD_INTO_CIVIC_KEY=your_telnyx_api_key_here

# Your Telnyx phone number (the one that receives calls from the call box)
# Must be in E.164 format: +1XXXXXXXXXX
TELNYX_PHONE_NUMBER=+14155551234

# Phone numbers to notify via SMS when gate is unlocked
# Comma-separated, E.164 format
# Example: your number and your wife's number
NOTIFY_NUMBERS=+14155551111,+14155552222

# Optional DTMF tuning
UNLOCK_DIGIT=5
TONE_DURATION_REPEATS=8
PAUSE_DURATION=0.5
ITERATIONS=3
